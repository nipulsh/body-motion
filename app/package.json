{
  "name": "body-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:1420 && node electron/run-dev.mjs\"",
    "electron:start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:exercise-videos": "tsx scripts/validate-exercise-videos.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.170.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.5"
  }
}
