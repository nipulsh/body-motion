# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Database (Supabase PostgreSQL) ---
# Transaction pooler (6543) for queries. Replace [YOUR-PASSWORD] with the real database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler or direct (5432) for migrations. Same password as DATABASE_URL.
DIRECT_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase Storage buckets (private) ---
SUPABASE_BUCKET_PATIENT_IMAGES=patient-images
SUPABASE_BUCKET_GENERATED_IMAGES=generated-images
SUPABASE_BUCKET_MODELS=models
SIGNED_URL_TTL_SECONDS=3600

# --- Object storage ---
# local writes files under LOCAL_STORAGE_DIR and serves them at /api/storage/...
# supabase uses private Storage buckets. Default is local while Storage is unreliable.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=storage
# Optional. Defaults to http://localhost:$PORT and must match the app's VITE_API_URL.
# PUBLIC_BASE_URL=http://localhost:3001

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# auto | inline | files — auto uploads via Files API when inline payload exceeds budget
GEMINI_UPLOAD_MODE=auto
GEMINI_INLINE_BUDGET_BYTES=14000000
GEMINI_FILE_ACTIVE_TIMEOUT_MS=180000

# --- Meshy (optional — 3D model + rigging pipeline) ---
# Leave disabled until you have a Meshy subscription. Pipeline stops after reference images.
MESHY_ENABLED=false
# MESHY_API_KEY=your-meshy-api-key
MESHY_API_BASE_URL=https://api.meshy.ai
MESHY_POLL_INTERVAL_MS=5000
MESHY_MAX_POLL_ATTEMPTS=120
# Meshy rejects rigging input above ~300k faces; keep generation under that ceiling
MESHY_TARGET_POLYCOUNT=30000
MESHY_RIG_HEIGHT_METERS=1.7
# latest / meshy-7 preferred for multi-view fidelity when your Meshy plan supports it
MESHY_AI_MODEL=latest
MESHY_TEXTURE_RESOLUTION=2k
MESHY_ENABLE_PBR=true

# --- Exercise demo videos (Gemini Veo) ---
# Requires Veo access on your Google AI project. Cached in Supabase under exercise-demos/.
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_POLL_INTERVAL_MS=10000
GEMINI_VIDEO_TIMEOUT_MS=600000

# --- Reference model image (operator-supplied, see src/assets/README.md) ---
REFERENCE_MODEL_IMAGE_PATH=src/assets/reference-male-model.png

# --- Security ---
# Comma-separated origins, or * for any origin
CORS_ORIGIN=http://localhost:1420
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_MAX=20
TRUST_PROXY=false
