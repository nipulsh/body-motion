{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@mediapipe/tasks-vision": ["../app/node_modules/@mediapipe/tasks-vision"],
      "onnxruntime-web/webgpu": ["../app/node_modules/onnxruntime-web/types.d.ts"],
      "vitest": ["../app/node_modules/vitest"]
    }
  },
  "include": ["./**/*.ts"]
}
